# ------------------------------------------------------------------
# AgroPoint POS — Node backend configuration
# Copy this file to `.env` and adjust as needed.
# ------------------------------------------------------------------

# Server
PORT=8000

# MySQL (same database the PHP backend used — Laragon defaults below)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=agropoint_pos
DB_USER=root
DB_PASS=

# Comma-separated list of allowed frontend origins, or * for any.
CORS_ORIGIN=*

# Auth — CHANGE THIS to a long random string in production.
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=7d
