{
  "name": "agropoint-backend-node",
  "version": "1.0.0",
  "description": "AgroPoint POS backend — Node.js + Express + TypeScript (replaces the PHP backend)",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "migrate": "tsx migrations/run.ts",
    "migrate-v2": "node dist/migrations/run.js",
    "hash-passwords": "tsx migrations/002_hash_passwords.ts",
    "build-v2": "tsc && npm run copy-sql",
    "copy-sql": "cp -r migrations/*.sql dist/migrations/"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.11.0",
    "tsx": "^4.16.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.14.0",
    "typescript": "^5.5.0"
  }
}